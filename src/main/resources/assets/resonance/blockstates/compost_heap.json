{
	"multipart": [
		{
			"apply": [
				{ "model": "resonance:block/compost_heap/compost_heap" },
				{ "model": "resonance:block/compost_heap/compost_heap", "y": 90 },
				{ "model": "resonance:block/compost_heap/compost_heap", "y": 180 },
				{ "model": "resonance:block/compost_heap/compost_heap", "y": 270 }
			],
			"when": {
				"OR": [
					{ "north": "false" },
					{ "east": "false" },
					{ "south": "false" },
					{ "west": "false" }
				]
			}
		},
		{
			"apply": [
				{ "model": "resonance:block/compost_heap/compost_heap_tall" },
				{ "model": "resonance:block/compost_heap/compost_heap_tall", "y": 90 },
				{ "model": "resonance:block/compost_heap/compost_heap_tall", "y": 180 },
				{ "model": "resonance:block/compost_heap/compost_heap_tall", "y": 270 }
			],
			"when": { "north": "true", "east": "true", "south": "true", "west": "true" }
		},
		{
			"apply": [
				{ "model": "resonance:block/compost_heap/compost_heap_side_0" },
				{ "model": "resonance:block/compost_heap/compost_heap_side_1" },
				{ "model": "resonance:block/compost_heap/compost_heap_side_2" },
				{ "model": "resonance:block/compost_heap/compost_heap_side_3" }
			],
			"when": { "north": "false" }
		},
		{
			"apply": [
				{ "model": "resonance:block/compost_heap/compost_heap_side_1", "y": 90 },
				{ "model": "resonance:block/compost_heap/compost_heap_side_2", "y": 90 },
				{ "model": "resonance:block/compost_heap/compost_heap_side_3", "y": 90 },
				{ "model": "resonance:block/compost_heap/compost_heap_side_0", "y": 90 }
			],
			"when": { "east": "false" }
		},
		{
			"apply": [
				{ "model": "resonance:block/compost_heap/compost_heap_side_2", "y": 180 },
				{ "model": "resonance:block/compost_heap/compost_heap_side_3", "y": 180 },
				{ "model": "resonance:block/compost_heap/compost_heap_side_0", "y": 180 },
				{ "model": "resonance:block/compost_heap/compost_heap_side_1", "y": 180 }
			],
			"when": { "south": "false" }
		},
		{
			"apply": [
				{ "model": "resonance:block/compost_heap/compost_heap_side_3", "y": 270 },
				{ "model": "resonance:block/compost_heap/compost_heap_side_0", "y": 270 },
				{ "model": "resonance:block/compost_heap/compost_heap_side_1", "y": 270 },
				{ "model": "resonance:block/compost_heap/compost_heap_side_2", "y": 270 }
			],
			"when": { "west": "false" }
		}
	]
}